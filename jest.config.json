{
  "moduleFileExtensions": ["ts", "js"],
  "rootDir": "test",
  "testEnvironment": "node",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": {
          "esModuleInterop": true,
          "allowSyntheticDefaultImports": true
        },
        "diagnostics": {
          "warnOnly": true
        }
      }
    ]
  },
  "testMatch": ["<rootDir>/*.spec.ts"]
}
