// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User model
model User {
  id        String   @id @default(uuid()) @db.Uuid
  login     String   @unique
  password  String
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// Artist model
model Artist {
  id     String  @id @default(uuid()) @db.Uuid
  name   String
  grammy Boolean @default(false)

  // Relations
  albums    Album[]
  tracks    Track[]
  favorites FavoriteArtist[]

  @@map("artists")
}

// Album model
model Album {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  year     Int
  artistId String? @map("artist_id") @db.Uuid

  // Relations
  artist    Artist?         @relation(fields: [artistId], references: [id], onDelete: SetNull)
  tracks    Track[]
  favorites FavoriteAlbum[]

  @@map("albums")
}

// Track model
model Track {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  artistId String? @map("artist_id") @db.Uuid
  albumId  String? @map("album_id") @db.Uuid
  duration Int

  // Relations
  artist    Artist?         @relation(fields: [artistId], references: [id], onDelete: SetNull)
  album     Album?          @relation(fields: [albumId], references: [id], onDelete: SetNull)
  favorites FavoriteTrack[]

  @@map("tracks")
}

// Favorites model (one record with many-to-many relations)
model Favorite {
  id String @id @default(uuid()) @db.Uuid

  // Relations (many-to-many via join tables)
  artists FavoriteArtist[]
  albums  FavoriteAlbum[]
  tracks  FavoriteTrack[]

  @@map("favorites")
}

// Join table for Favorite <-> Artist
model FavoriteArtist {
  favoriteId String   @map("favorite_id") @db.Uuid
  artistId   String   @map("artist_id") @db.Uuid
  favorite   Favorite @relation(fields: [favoriteId], references: [id], onDelete: Cascade)
  artist     Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([favoriteId, artistId])
  @@map("favorite_artists")
}

// Join table for Favorite <-> Album
model FavoriteAlbum {
  favoriteId String   @map("favorite_id") @db.Uuid
  albumId    String   @map("album_id") @db.Uuid
  favorite   Favorite @relation(fields: [favoriteId], references: [id], onDelete: Cascade)
  album      Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([favoriteId, albumId])
  @@map("favorite_albums")
}

// Join table for Favorite <-> Track
model FavoriteTrack {
  favoriteId String   @map("favorite_id") @db.Uuid
  trackId    String   @map("track_id") @db.Uuid
  favorite   Favorite @relation(fields: [favoriteId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([favoriteId, trackId])
  @@map("favorite_tracks")
}
