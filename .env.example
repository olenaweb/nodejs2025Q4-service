# Application
NODE_ENV=development
PORT=4000

# Logging
# Logging level (0-5)
# 0 = fatal, 1 = error, 2 = warn, 3 = log, 4 = debug, 5 = verbose
# Note: Incoming requests (→) and responses (←) are logged at level 3 (log)
LOG_LEVEL=4

# File logging settings
# Maximum size of log file before rotation (e.g., 1k, 10m, 100m, 1g)
LOG_FILE_MAX_SIZE=10m

# How long to keep log files (e.g., 7d, 14d, 30d, 90d)
LOG_FILE_MAX_FILES=14d

# Authentication
CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

# Database
# !!! POSTGRES_HOST - for local development use localhost, for Docker - postgres
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=home_library
POSTGRES_PORT=5432
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/home_library?schema=public"
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Prisma
# DATABASE_LOGGING options:
# - 'none' or 'false' = no logs
# - 'error' = only errors
# - 'warn' = warnings and errors (default if not set)
# - 'info' = info, warnings and errors
# - 'query' = SQL queries, warnings and errors
# - 'all' or 'true' = all logs (queries, info, warnings, errors)
DATABASE_LOGGING=none
